<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CrownAndCompass.Sim</RootNamespace>
  </PropertyGroup>

  <!-- The gameplay data lives in content/game/ at the repo root. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\content\game\*.json" LogicalName="content.%(Filename)%(Extension)" Link="content\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The content library (SRD, open books, originals): only the kinds the sim reads. -->
  <ItemGroup>
    <LibraryFile Include="..\..\..\content\**\monsters.json;..\..\..\content\**\classes.json;..\..\..\content\**\spells.json;..\..\..\content\**\magic-items.json" Exclude="..\..\..\content\game\**" />
    <EmbeddedResource Include="@(LibraryFile)" LogicalName="library/%(RecursiveDir)%(Filename)%(Extension)" Link="library\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
